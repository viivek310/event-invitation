# Non-secret deployment settings. Copy to .env.production on the Linux server.
COMPOSE_PROJECT_NAME=invitation-production
DOMAIN=invite.yourdomain.com
APP_IMAGE=events-invitation:release-001
OPS_IMAGE=events-invitation-ops:release-001
DB_NAME=event-invitation
DB_APP_USER=invitation_app
DB_MIGRATION_USER=invitation_migrator
TZ=Asia/Kolkata
TRAEFIK_NETWORK=traefik-network
TRAEFIK_CERT_RESOLVER=letsencrypt
SECRETS_DIR=./secrets/production
# Only true when your Traefik overwrites incoming forwarded headers and the
# shared Docker network is trusted. False uses a conservative shared IP bucket.
TRUST_PROXY=false
