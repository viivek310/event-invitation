  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:routes": "node tests/routes.mjs",
    "test:browser": "playwright test",
    "db:start": "docker compose --env-file .env.db -f compose.db.yml up -d --wait",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:catalog": "tsx scripts/catalog-sync.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "setup:local": "node scripts/init-local.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.3",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
